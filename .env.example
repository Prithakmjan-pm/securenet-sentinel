# Required
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — must be a model that reliably supports tool calling /
# structured output on OpenRouter, since Agents 2 and 3 rely on it.
# Good free options: openai/gpt-oss-120b:free, nex-agi/nex-n2-pro:free,
# baidu/cobuddy:free
SECURENET_MODEL=openai/gpt-oss-120b:free
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# Only needed if you wired up the n8n human-in-the-loop audit logging
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/incident-approval
